{
  "id": "io.github.IvanBez42.Hotbar",
  "runtime": "org.gnome.Platform",
  "runtime-version": "51",
  "sdk": "org.gnome.Sdk",
  "command": "hotbar",
  "finish-args": [
    "--share=ipc",
    "--share=network",
    "--device=dri",
    "--device=input",
    "--require-version=1.16.0",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--talk-name=org.freedesktop.Flatpak",
    "--filesystem=/var/lib/flatpak/app:ro",
    "--filesystem=/var/lib/flatpak/exports:ro",
    "--filesystem=xdg-data/flatpak/app:ro",
    "--filesystem=xdg-data/flatpak/exports:ro",
    "--filesystem=~/.steam:ro",
    "--filesystem=xdg-data/Steam:ro",
    "--filesystem=xdg-config/heroic:ro",
    "--filesystem=xdg-config/legendary:ro",
    "--filesystem=xdg-config/itch:ro",
    "--filesystem=xdg-data/lutris:ro",
    "--filesystem=~/.var/app/com.valvesoftware.Steam/data/Steam/:ro",
    "--filesystem=~/.var/app/com.heroicgameslauncher.hgl/config/heroic/:ro",
    "--filesystem=~/.var/app/io.itch.itch/config/itch/:ro",
    "--filesystem=~/.var/app/net.lutris.Lutris/data/lutris/:ro"
  ],
  "cleanup": [
    "/include",
    "/lib/pkgconfig",
    "/man",
    "/share/doc",
    "/share/gtk-doc",
    "/share/man",
    "/share/pkgconfig",
    "*.la",
    "*.a"
  ],
  "modules": [
    {
      "name": "hotbar",
      "builddir": true,
      "buildsystem": "meson",
      "config-opts": ["-Dprofile=release"],
      "sources": [
        {
          "type": "git",
          "path": "../",
          "branch": "main"
        }
      ],
      "modules": ["python3-pillow.json"]
    }
  ]
}
